{
	"name": "@xarsh/archivebridge",
	"version": "0.0.1",
	"description": "Interoperability layer for saved web page archive formats (MHTML/MHT, Safari WebArchive).",
	"type": "module",
	"keywords": [
		"mhtml",
		"mht",
		"webarchive",
		"web-archive",
		"archive",
		"interoperability"
	],
	"author": "Takao Naito <xarsh@outlook.com> (https://xar.sh)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xarsh/archivebridge.git",
		"directory": "packages/archivebridge"
	},
	"bugs": {
		"url": "https://github.com/xarsh/archivebridge/issues"
	},
	"homepage": "https://github.com/xarsh/archivebridge#readme",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"archivebridge": "./dist/cli/bin.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@exodus/bytes": "^1.15.1",
		"iconv-lite": "^0.7.3",
		"parse5": "^8.0.1",
		"plist": "^5.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test \"src/**/*.test.ts\"",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run typecheck && npm run test && npm run lint",
		"clean": "rm -rf dist"
	}
}
