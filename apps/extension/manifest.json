{
	"manifest_version": 3,
	"name": "ArchiveBridge",
	"version": "0.1.0",
	"description": "Save the current page as MHTML or Safari WebArchive.",
	"minimum_chrome_version": "116",
	"permissions": ["pageCapture", "downloads", "offscreen", "contextMenus"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "ArchiveBridge"
	}
}
