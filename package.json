{
	"name": "archivebridge",
	"version": "0.0.1",
	"description": "ArchiveBridge is an interoperability layer for saved web page archive formats (MHTML/MHT, Safari WebArchive).",
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check:filenames": "node scripts/check-filenames.mjs",
		"check": "npm run typecheck && npm run test && npm run lint && npm run check:filenames && npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xarsh/archivebridge.git"
	},
	"keywords": [],
	"author": "Takao Naito <xarsh@outlook.com> (https://xar.sh)",
	"license": "MIT",
	"type": "module",
	"bugs": {
		"url": "https://github.com/xarsh/archivebridge/issues"
	},
	"homepage": "https://github.com/xarsh/archivebridge#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^26.5.0",
		"typescript": "^7.0.2"
	},
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	]
}
